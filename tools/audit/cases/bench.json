{
  "_설명": "벤치프레스 판단 규칙의 고정 사례. 기대값은 앱을 실행해서 얻은 것이 아니라, docs/audit/bench-traceability.md의 규칙 표(점수·선택·우선순위·공통 규칙)를 사람이 손으로 계산해 적은 것이다. 앱 코드나 규칙이 바뀌어 결과가 달라지면 테스트가 실패한다. 이 사례들은 '코드가 적힌 규칙대로 동작하는지'만 확인하며, 규칙의 의학적 타당성은 확인하지 않는다(전문가 검토 대상).",
  "base": { "where": "unsure", "when": "after", "grip": "g1", "elbow": "mid", "scap": "yes", "other": ["none"], "daily": ["none"], "load": "lt1", "dur": "lt2", "trend": "same", "acc": "regular" },
  "_base_설명": "모든 점수가 0이 되는 답. 각 사례는 이 답에서 일부만 바꾼다.",
  "cases": [
    { "id": "C01", "desc": "모든 점수 0 → 변수 없음, 좁히기 어려움, 조정 없음 (무게 후보가 있어도)",
      "set": {}, "expect": { "patterns": [], "adjustments": [], "unclear": true, "referFirst": false },
      "covers": ["common.F.zero", "common.F.unclearNoAdj", "bench.SEL.1", "bench.SEL.3"] },
    { "id": "C02", "desc": "rc 3 = acj 3 동점 → rc가 맨 앞(acj가 '더 클 때'만 acj), acj 3은 기준선 3 이상이라 함께 표시. 조정: 그립2·무게6·스트레칭7",
      "set": { "where": "front", "when": "lower", "grip": "g2", "daily": ["cross"] },
      "expect": { "patterns": ["rc", "acj"], "adjustments": ["grip", "load", "flex"], "unclear": false, "referFirst": false },
      "covers": ["bench.SEL.1", "bench.SEL.2", "bench.SEL.4", "bench.S.rc.where=front/where=sideback", "bench.S.rc.when=lower/when=press", "bench.S.acj.grip=g2", "bench.S.acj.daily=cross", "bench.P.load", "bench.P.grip", "bench.P.flex", "common.F.top3"] },
    { "id": "C03", "desc": "rc 4 = acj 4 동점(더 높은 점수) → rc 맨 앞, acj 함께. 무게 우선순위 6",
      "set": { "where": "top", "when": "press", "other": ["lateral", "upright", "ohp"] },
      "expect": { "patterns": ["rc", "acj"], "adjustments": ["load"], "unclear": false, "referFirst": false },
      "covers": ["bench.SEL.1", "bench.SEL.4", "bench.S.acj.where=top", "bench.S.rc.other=lateral", "bench.S.rc.other=upright", "bench.S.rc.other=ohp", "bench.P.load"] },
    { "id": "C04", "desc": "acj 4 > rc 1 → acj 맨 앞, rc 1은 기준선 미만. 맨 앞이 acj라서 무게 우선순위 1",
      "set": { "where": "top", "when": "lower" },
      "expect": { "patterns": ["acj"], "adjustments": ["load"], "unclear": false, "referFirst": false },
      "covers": ["bench.SEL.1", "bench.SEL.4", "bench.P.load"] },
    { "id": "C05", "desc": "맨 앞 rc, 1RM 1.5배 넘음 → 무게 우선순위 1. 보조운동4·팔꿈치5 순서",
      "set": { "where": "front", "when": "lower", "load": "gt15", "elbow": "flared", "acc": "sometimes" },
      "expect": { "patterns": ["rc"], "adjustments": ["load", "acc", "elbow"], "unclear": false, "referFirst": false },
      "covers": ["bench.S.acj.load=gt15", "bench.P.load", "bench.P.acc", "bench.P.elbow", "bench.SEL.4", "common.F.top3"] },
    { "id": "C06", "desc": "후보 6개 모두 → 상위 3개(그립2·날개뼈3·보조운동4)만, 무게6·팔꿈치5·스트레칭7은 빠짐",
      "set": { "where": "front", "when": "lower", "grip": "g15", "elbow": "tucked", "scap": "no", "acc": "never", "daily": ["behind"], "load": "mid" },
      "expect": { "patterns": ["rc", "scap"], "adjustments": ["grip", "scap", "acc"], "unclear": false, "referFirst": false },
      "covers": ["common.F.top3", "bench.S.acj.grip=g15", "bench.S.scap.scap=no/scap=unsure", "bench.S.scap.acc=never", "bench.SEL.5", "bench.P.grip", "bench.P.scap", "bench.P.acc", "bench.P.elbow", "bench.P.flex", "bench.P.load"] },
    { "id": "C07", "desc": "C06 + 1RM 1.5배 넘음 → acj 3 = rc 3 동점으로 rc 맨 앞·acj 함께, 무게 우선순위 1로 맨 앞",
      "set": { "where": "front", "when": "lower", "grip": "g15", "elbow": "tucked", "scap": "no", "acc": "never", "daily": ["behind"], "load": "gt15" },
      "expect": { "patterns": ["rc", "acj", "scap"], "adjustments": ["load", "grip", "scap"], "unclear": false, "referFirst": false },
      "covers": ["bench.P.load", "common.F.top3", "bench.SEL.1", "bench.SEL.4", "bench.SEL.5"] },
    { "id": "C08", "desc": "기준선 경계: 맨 앞 acj, rc 2 → rc 안 보임",
      "set": { "where": "top", "other": ["lateral", "upright"] },
      "expect": { "patterns": ["acj"], "adjustments": ["load"], "unclear": false, "referFirst": false },
      "covers": ["bench.SEL.4"] },
    { "id": "C09", "desc": "기준선 경계: 맨 앞 acj, rc 3 → rc 함께 보임",
      "set": { "where": "top", "other": ["lateral", "upright", "ohp"] },
      "expect": { "patterns": ["acj", "rc"], "adjustments": ["load"], "unclear": false, "referFirst": false },
      "covers": ["bench.SEL.4"] },
    { "id": "C10", "desc": "날개뼈 기준선 경계: scap 1 → 안 보임. 조정: 보조운동4·무게6",
      "set": { "where": "front", "acc": "never" },
      "expect": { "patterns": ["rc"], "adjustments": ["acc", "load"], "unclear": false, "referFirst": false },
      "covers": ["bench.SEL.5", "bench.S.scap.acc=never", "bench.P.acc"] },
    { "id": "C11", "desc": "날개뼈 기준선 경계: scap 2 → 보임. 조정: 날개뼈3·무게6",
      "set": { "where": "front", "scap": "unsure" },
      "expect": { "patterns": ["rc", "scap"], "adjustments": ["scap", "load"], "unclear": false, "referFirst": false },
      "covers": ["bench.SEL.5", "bench.S.scap.scap=no/scap=unsure", "bench.P.scap"] },
    { "id": "C12", "desc": "rc·acj 0점, scap 2 → 맨 앞 rc가 빠져 좁히기 어려움, scap만 남고 조정은 보임",
      "set": { "scap": "no" },
      "expect": { "patterns": ["scap"], "adjustments": ["scap", "load"], "unclear": true, "referFirst": false },
      "covers": ["common.F.zero", "common.F.unclearNoAdj"] },
    { "id": "C13", "desc": "일상에서도 아픔(when=daily) → 진료 먼저, 조정은 '참고만'으로 보임. when=daily는 rc 점수에 안 들어감",
      "set": { "where": "front", "when": "daily" },
      "expect": { "patterns": ["rc"], "adjustments": ["load"], "unclear": false, "referFirst": true },
      "covers": ["bench.REFER.daily", "common.F.referFirst"] },
    { "id": "C14", "desc": "6주 이상 → 진료 먼저 (C02와 같은 변수·조정)",
      "set": { "where": "front", "when": "lower", "grip": "g2", "daily": ["cross"], "dur": "gt6" },
      "expect": { "patterns": ["rc", "acj"], "adjustments": ["grip", "load", "flex"], "unclear": false, "referFirst": true },
      "covers": ["common.F.referLong", "common.F.referFirst"] },
    { "id": "C15", "desc": "나빠지는 중 → 진료 먼저",
      "set": { "where": "front", "trend": "worse" },
      "expect": { "patterns": ["rc"], "adjustments": ["load"], "unclear": false, "referFirst": true },
      "covers": ["common.F.referWorse", "common.F.referFirst"] },
    { "id": "C16", "desc": "어깨 옆·뒤 + 머리 위로 팔 들기 불편 → rc 4",
      "set": { "where": "sideback", "daily": ["overhead"] },
      "expect": { "patterns": ["rc"], "adjustments": ["load"], "unclear": false, "referFirst": false },
      "covers": ["bench.S.rc.where=front/where=sideback", "bench.S.rc.daily=overhead"] },
    { "id": "C17", "desc": "그립 2배는 +2만(1.5배 +1과 겹치지 않음): acj = 2 + 2(1RM) = 4 > rc 3",
      "set": { "where": "front", "when": "lower", "grip": "g2", "load": "gt15" },
      "expect": { "patterns": ["acj", "rc"], "adjustments": ["load", "grip"], "unclear": false, "referFirst": false },
      "covers": ["bench.S.acj.grip=g2", "bench.S.acj.grip=g15", "bench.S.acj.load=gt15", "bench.SEL.1", "bench.SEL.2"] }
  ],
  "partial": {
    "common.F.top3": "같은 우선순위 숫자일 때 코드에 넣은 순서를 따르는 부분은 벤치프레스에 같은 숫자가 없어 확인하지 못함 (수동 검토 필요)"
  },
  "notApplicable": {
    "common.F.referOnly": "벤치프레스에는 '→ 진료 먼저' 변수(referOnly)가 없어 이 주제에서는 확인할 수 없다 (다른 주제에서 확인 필요)."
  }
}
